# Copy to .env.local for development. Never commit real values (spec §7).

# Postgres. Supabase or Neon in deployment; any Postgres 15+ locally.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediaclicks"

# Auth.js v5. Generate with: npx auth secret
AUTH_SECRET=""

# Required in production; inferred from the request in development.
AUTH_URL="http://localhost:3000"

# Seed script: the day-one Owner account (spec §8 open question).
# Used only by `npm run db:seed`, never read at runtime.
SEED_ORG_NAME="MediaClicks"
SEED_OWNER_EMAIL="owner@mediaclicks.ae"
SEED_OWNER_NAME="Owner"
SEED_OWNER_PASSWORD=""

# Conferencing (§4.2). Absent = the platform reports itself unconfigured, the
# meeting still saves without a link, and the UI offers a retry.
# Google Meet: per-user OAuth with the calendar scope; refresh tokens encrypted.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Zoom: one org-level Server-to-Server OAuth app. Requires a paid plan.
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
