# Copy to .env.local for development. Never commit real values (spec §7).

# Postgres. Supabase or Neon in deployment; any Postgres 15+ locally.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediaclicks"

# Auth.js v5. Generate with: npx auth secret
AUTH_SECRET=""
# Also signs the assistant's confirmation plans (§4.6, ADR 0007), so that
# confirming executes what was proposed and not what a browser sent back.

# Required in production; inferred from the request in development.
AUTH_URL="http://localhost:3000"

# Seed script: the day-one Owner account (spec §8 open question).
# Used only by `npm run db:seed`, never read at runtime.
SEED_ORG_NAME="MediaClicks"
SEED_OWNER_EMAIL="owner@mediaclicks.ae"
SEED_OWNER_NAME="Owner"
SEED_OWNER_PASSWORD=""
# IANA zone for seeded and newly created accounts. The agency is in Dubai;
# anyone elsewhere changes it in Profile, which now actually takes effect
# across the whole shell rather than only below the header.
SEED_TIMEZONE="Asia/Dubai"

# Email to clients. Absent = the meeting still saves and the failure is
# recorded to the audit log; nothing is lost, nothing is sent.
RESEND_API_KEY=""
MAIL_FROM="MediaClicks <ops@mediaclicks.ae>"

# Shared secret for the notification worker (§4.4). The scheduled GitHub
# Actions workflow sends it as a bearer token; without it the route 404s.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Optional. Free key from https://console.groq.com/keys. When set, the
# assistant falls back to this model for any phrasing the grammar in
# src/lib/assistant/parse.ts doesn't recognise (ADR 0007). Blank = the
# assistant only understands the grammar's fixed set of phrasings, same as
# before this existed.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Second factor at sign-in (ADR 0010). Normally leave this blank: it is a
# per-person setting now, off by default, turned on from Profile or from the
# one-time offer on Home.
#
# Setting it to "required" mandates a code for everyone regardless of what
# they chose — for an agency that decides to stop leaving it optional.
#
# Either way a working mailer is the precondition, so setting this before
# email works is survivable: nothing happens until a code can actually be
# delivered. Without that guard it would demand a code that cannot be sent,
# locking every account out permanently, including the owner who would need
# to sign in to undo it. See src/lib/auth/two-factor.ts.
AUTH_2FA=""

# Google sign-in. Both must be set or the provider is not registered at all
# and the button says so instead of failing on click.
#
# There is no allowlist to maintain: only addresses that already have an
# active row in `users` can sign in this way, so the Team screen is the
# allowlist. An unknown Google account is refused even with a valid Google
# session.
#
# Create at console.cloud.google.com -> APIs & Services -> Credentials ->
# OAuth client ID -> Web application. Authorised redirect URI:
#   https://<your-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google   (development)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
